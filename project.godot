; LexiDoors — protótipo offline para Windows.
config_version=5

[application]
config/name="LexiDoors"
config/version="0.2.0"
run/main_scene="res://scenes/main.tscn"
run/max_fps=120
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="Um desafio de inglês atrás de cada porta."
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/resizable=true
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.027, 0.051, 0.071, 1)

[audio]
driver/enable_input=false
